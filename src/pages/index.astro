</footer>

<dialog id="image-dialog">
  <button id="close-dialog">×</button>
  <img id="dialog-image" src="" alt="" />
</dialog>

<script>
  const dialog = document.getElementById("image-dialog") as HTMLDialogElement;
  const dialogImage = document.getElementById("dialog-image") as HTMLImageElement;
  const closeButton = document.getElementById("close-dialog") as HTMLButtonElement;

  document.querySelectorAll(".zoomable-image").forEach((img) => {
  img.addEventListener("click", () => {
    dialogImage.src = (img as HTMLImageElement).src;
    dialogImage.alt = (img as HTMLImageElement).alt;
    dialog.showModal();
  });
});

  closeButton.addEventListener("click", () => {
    dialog.close();
  });

  dialog.addEventListener("click", (event) => {
    if (event.target === dialog) {
      dialog.close();
    }
  });

  // ハッシュ付きでアクセス／リンククリックされたキャラの details を開いてからジャンプ
  const openTargetFromHash = () => {
    const id = decodeURIComponent(location.hash.slice(1));
    if (!id) return;
    const target = document.getElementById(id);
    if (target instanceof HTMLDetailsElement) {
      target.open = true;
      target.scrollIntoView();
    }
  };

  window.addEventListener("hashchange", openTargetFromHash);
  openTargetFromHash();

  // 各キャラ末尾の「閉じる」ボタン（主にスマホ用）
  document.querySelectorAll(".close-character").forEach((btn) => {
    btn.addEventListener("click", () => {
      const id = (btn as HTMLButtonElement).dataset.target;
      if (!id) return;
      const target = document.getElementById(id);
      if (target instanceof HTMLDetailsElement) {
        target.open = false;
        target.scrollIntoView({ block: "start" });
      }
    });
  });

</script>

</body>